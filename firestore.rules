rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/attempts/{attemptId} {
      function ownsDocument() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validAttempt() {
        return request.resource.data.keys().hasOnly([
          'id', 'mode', 'subject', 'year', 'questionIds', 'answers',
          'startedAt', 'submittedAt', 'elapsedSeconds', 'correctCount',
          'wrongCount', 'unansweredCount', 'syncedAt'
        ])
        && request.resource.data.id == attemptId
        && request.resource.data.mode == 'paper'
        && request.resource.data.subject is string
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() <= 200
        && request.resource.data.answers is map
        && request.resource.data.startedAt is string
        && request.resource.data.submittedAt is string
        && request.resource.data.elapsedSeconds is int
        && request.resource.data.elapsedSeconds >= 0
        && request.resource.data.correctCount is int
        && request.resource.data.wrongCount is int
        && request.resource.data.unansweredCount is int;
      }

      allow read, delete: if ownsDocument();
      allow create, update: if ownsDocument() && validAttempt();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
