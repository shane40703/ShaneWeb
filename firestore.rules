rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authoring is Console/IAM-only. Test mode is a public preview, not a secret.
    match /pushMessages/{messageId} {
      allow read: if resource.data.status in ['test', 'live'];
      allow create, delete: if false;

      function count(data, key) {
        return data.get(key, 0);
      }
      function validCounterUpdate() {
        let stage = resource.data.status;
        let delivery = stage == 'test' ? 'testDelivered' : 'delivered';
        let reading = stage == 'test' ? 'testRead' : 'read';
        let receiptId = request.resource.data.lastReceiptId;
        let path = /databases/$(database)/documents/pushMessages/$(messageId)/receipts/$(receiptId);
        let existed = exists(path);
        let beforeRead = existed ? get(path).data.read == true : false;
        let after = getAfter(path).data;
        let statsPath = /databases/$(database)/documents/pushMessages/$(messageId)/stats/$(stage);
        return stage in ['test', 'live']
          // Old clients may keep using parent counters during rollout, but cannot
          // increment both the legacy and new counters with the same receipt.
          && (!existsAfter(statsPath) || (exists(statsPath) && getAfter(statsPath).data == get(statsPath).data))
          && resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time
          && receiptId is string && receiptId.matches(stage + '_[a-f0-9-]{36}')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([delivery, reading, 'lastReceiptId'])
          && after.status == stage && after.delivered == true && after.read is bool
          && (!beforeRead || after.read)
          && (!existed || (!beforeRead && after.read))
          && count(request.resource.data, delivery) is int
          && count(request.resource.data, reading) is int
          && count(request.resource.data, delivery) == count(resource.data, delivery) + (existed ? 0 : 1)
          && count(request.resource.data, reading) == count(resource.data, reading) + (!beforeRead && after.read ? 1 : 0);
      }
      allow update: if validCounterUpdate();

      match /stats/{stage} {
        allow get: if stage in ['test', 'live'];
        allow list, delete: if false;

        function validStats() {
          let parentPath = /databases/$(database)/documents/pushMessages/$(messageId);
          let statsPath = /databases/$(database)/documents/pushMessages/$(messageId)/stats/$(stage);
          let parent = get(parentPath).data;
          let old = exists(statsPath) ? get(statsPath).data : {};
          let data = request.resource.data;
          let receiptId = data.lastReceiptId;
          let receiptPath = /databases/$(database)/documents/pushMessages/$(messageId)/receipts/$(receiptId);
          let existed = exists(receiptPath);
          let beforeRead = existed ? get(receiptPath).data.read == true : false;
          let after = getAfter(receiptPath).data;
          return stage in ['test', 'live'] && parent.status == stage
            && parent.expiresAt is timestamp && parent.expiresAt > request.time
            && getAfter(parentPath).data == parent
            && data.keys().hasOnly(['delivered', 'read', 'lastReceiptId'])
            && receiptId is string && receiptId.matches(stage + '_[a-f0-9-]{36}')
            && after.status == stage && after.delivered == true && after.read is bool
            && (!beforeRead || after.read)
            && (!existed || (!beforeRead && after.read))
            && data.delivered is int && data.read is int
            && data.delivered == count(old, 'delivered') + (existed ? 0 : 1)
            && data.read == count(old, 'read') + (!beforeRead && after.read ? 1 : 0);
        }
        allow create, update: if validStats();
      }

      match /receipts/{receiptId} {
        // A random browser token, never an account identifier. No enumeration.
        allow get: if receiptId.matches('(test|live)_[a-f0-9-]{36}');
        allow list, delete: if false;
        function validReceipt() {
          let path = /databases/$(database)/documents/pushMessages/$(messageId);
          let parent = get(path).data;
          let after = getAfter(path).data;
          let data = request.resource.data;
          let statsPath = /databases/$(database)/documents/pushMessages/$(messageId)/stats/$(data.status);
          return data.keys().hasOnly(['status', 'delivered', 'read'])
            && data.status in ['test', 'live'] && data.status == parent.status
            && receiptId.matches(data.status + '_[a-f0-9-]{36}')
            && data.delivered == true && data.read is bool
            && parent.expiresAt > request.time
            && ((after != parent && after.lastReceiptId == receiptId)
              || (existsAfter(statsPath) && getAfter(statsPath).data.lastReceiptId == receiptId
                && (!exists(statsPath) || getAfter(statsPath).data != get(statsPath).data)));
        }
        allow create: if validReceipt();
        allow update: if validReceipt() && resource.data.read == false && request.resource.data.read == true;
      }
    }

    // Per-user unfinished practice and paper drafts. Null payloads are durable tombstones.
    match /users/{userId}/progress/{progressId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && (progressId == 'practice' || progressId.matches('paper-(law|env|construction|structure)-[0-9]{3}'))
        && request.resource.data.keys().hasOnly(['version', 'payload', 'updatedAt', 'writer', 'syncedAt'])
        && request.resource.data.version == 1
        && (request.resource.data.payload == null || (request.resource.data.payload is string && request.resource.data.payload.size() <= 700000))
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= 0
        && request.resource.data.writer is string && request.resource.data.writer.size() > 0 && request.resource.data.writer.size() <= 80
        && request.resource.data.syncedAt == request.time;
      allow delete: if false;
    }

    match /users/{userId}/attempts/{attemptId} {
      function ownsDocument() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validAttempt() {
        return request.resource.data.keys().hasOnly([
          'id', 'mode', 'subject', 'year', 'questionIds', 'answers',
          'startedAt', 'submittedAt', 'elapsedSeconds', 'correctCount',
          'wrongCount', 'unansweredCount', 'syncedAt'
        ])
        && request.resource.data.id == attemptId
        && request.resource.data.mode in ['paper', 'practice']
        && request.resource.data.subject is string
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() <= 200
        && request.resource.data.answers is map
        && request.resource.data.startedAt is string
        && request.resource.data.submittedAt is string
        && request.resource.data.elapsedSeconds is int
        && request.resource.data.elapsedSeconds >= 0
        && request.resource.data.correctCount is int
        && request.resource.data.wrongCount is int
        && request.resource.data.unansweredCount is int;
      }

      allow read, delete: if ownsDocument();
      allow create, update: if ownsDocument() && validAttempt();
    }

    match /users/{userId}/notes/{questionId} {
      function ownsNote() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validNote() {
        return request.resource.data.keys().hasOnly([
          'questionId', 'content', 'updatedAt', 'syncedAt'
        ])
        && request.resource.data.questionId == questionId
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 20000
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40
        && request.resource.data.syncedAt is timestamp;
      }

      allow read: if ownsNote();
      allow create, update: if ownsNote() && validNote();
      allow delete: if false;
    }

    match /users/{userId}/settings/difficult {
      function ownsDifficultSettings() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if ownsDifficultSettings();
      allow create, update: if ownsDifficultSettings()
        && request.resource.data.keys().hasOnly([
          'questionIds', 'updatedAt', 'syncedAt'
        ])
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() <= 5000
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40
        && request.resource.data.syncedAt is timestamp;
      allow delete: if false;
    }

    match /users/{userId}/settings/interface {
      function ownsInterfaceSettings() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validPalette(palette) {
        return palette is map
          && palette.keys().hasOnly([
            'background', 'surface', 'text', 'muted', 'accent', 'border'
          ])
          && palette.keys().hasAll([
            'background', 'surface', 'text', 'muted', 'accent', 'border'
          ])
          && palette.background is string
          && palette.surface is string
          && palette.text is string
          && palette.muted is string
          && palette.accent is string
          && palette.border is string;
      }

      function validCustomPalettes() {
        return request.resource.data.customPalettes is map
          && request.resource.data.customPalettes.keys().hasOnly(['light', 'dark'])
          && (!('light' in request.resource.data.customPalettes)
            || validPalette(request.resource.data.customPalettes.light))
          && (!('dark' in request.resource.data.customPalettes)
            || validPalette(request.resource.data.customPalettes.dark));
      }

      allow read: if ownsInterfaceSettings();
      allow create, update: if ownsInterfaceSettings()
        && request.resource.data.keys().hasOnly([
          'mode', 'customPalettes', 'questionFontSize', 'optionFontSize',
          'updatedAt', 'syncedAt'
        ])
        && request.resource.data.mode in ['light', 'dark']
        && validCustomPalettes()
        && request.resource.data.questionFontSize in [14, 16, 18, 20, 22, 24]
        && request.resource.data.optionFontSize in [14, 16, 18, 20, 22, 24]
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40
        && request.resource.data.syncedAt is timestamp;
      allow delete: if false;
    }

    match /discussionPosts/{postId} {
      function signedIn() {
        return request.auth != null;
      }

      function ownsPost() {
        return signedIn() && resource.data.authorId == request.auth.uid;
      }

      function parentPostIsActive() {
        return get(
          /databases/$(database)/documents/discussionPosts/$(postId)
        ).data.deleted == false;
      }

      function validPost() {
        return request.resource.data.keys().hasOnly([
          'questionId', 'type', 'content', 'authorId', 'authorName',
          'images', 'createdAt', 'deleted'
        ])
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() <= 80
        && request.resource.data.type in [
          'explanation', 'supplement', 'question', 'correction'
        ]
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 4
        && (request.resource.data.content.size() >= 1
          || request.resource.data.images.size() >= 1)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == '匿名使用者'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.deleted == false;
      }

      allow read: if true;
      allow create: if signedIn() && validPost();
      allow update: if ownsPost() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content', 'images', 'deleted'
          ])
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 0
          && request.resource.data.content.size() <= 5000
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 4
          && (request.resource.data.content.size() >= 1
            || request.resource.data.images.size() >= 1)
          && (!resource.data.keys().hasAny(['deleted'])
            || resource.data.deleted == false)
          && request.resource.data.deleted == false)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content', 'deleted', 'deletedAt'
          ])
          && request.resource.data.content == ''
          && request.resource.data.deleted == true
          && request.resource.data.deletedAt is timestamp)
      );
      allow delete: if false;

      match /replies/{replyId} {
        function validReply() {
          return request.resource.data.keys().hasOnly([
            'content', 'authorId', 'authorName', 'createdAt'
          ])
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 2000
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == '匿名使用者'
          && request.resource.data.createdAt is timestamp;
        }

        allow read: if true;
        allow create: if request.auth != null
          && parentPostIsActive()
          && validReply();
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }

      match /likes/{userId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && parentPostIsActive()
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == userId
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /reports/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && parentPostIsActive()
          && request.resource.data.keys().hasOnly(['reporterId', 'createdAt'])
          && request.resource.data.reporterId == userId
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /contentReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'pageUrl', 'questionId', 'category', 'description',
          'reporterId', 'status', 'createdAt'
        ])
        && request.resource.data.pageUrl is string
        && request.resource.data.pageUrl.size() <= 1000
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() <= 80
        && request.resource.data.category in [
          '題目內容', '答案', '圖片', '詳解', '其他'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 5000
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
